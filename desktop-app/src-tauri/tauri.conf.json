{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Creator Command Center",
  "version": "0.1.0",
  "identifier": "com.yangshao.creatorcommandcenter",
  "build": {
    "frontendDist": "../frontend",
    "beforeDevCommand": "npm run sync-frontend",
    "beforeBuildCommand": "npm run sync-frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Creator Command Center",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
